# ==============================================================================
# PRANJAL GIRI — ENGINEERING SYSTEMS CONSOLE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Duplicate this file as .env.local for local development.
# In production (e.g. Vercel, Supabase), configure these in your environment settings.

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Optional: Supabase Service Role Key (For direct Admin User Provisioning API)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend API Key for Email Delivery & Inbound Contact Notifications
RESEND_API_KEY=re_your_resend_api_key

# Master Administrator Email (Strictly authorizes access to /admin)
ADMIN_EMAIL=pranjalgiri1122005@gmail.com

# Site URL for Auth Callbacks and Link Redirection (e.g. http://localhost:3000 or https://pranjalgiri.dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
